{
  "name": "church-accounting",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Only the Access-protected custom domain serves this app. Never add the main site
  // (hobartchurch.org) here. See DEPLOY.md.
  "routes": [{ "pattern": "finance.hobartchurch.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The screens (HTML/JS/CSS) contain no data; all data comes from /api, which requires login.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church-accounting",
      // Production database, region OC (hobartchurch@gmail.com account).
      "database_id": "4f4a0907-6798-45a3-9b1a-e8289b32c97f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Anything other than "development" disables the local-login shortcut.
    "ENVIRONMENT": "production",
    // Cloudflare Access: "<team>.cloudflareaccess.com" and the application's AUD tag.
    // While either is empty, every request is rejected (fails closed).
    "ACCESS_TEAM_DOMAIN": "round-pine-9680.cloudflareaccess.com",
    "ACCESS_AUD": "cb4a177a7d9f0ebdef72d16f403219165d472919d062d1720631201bf8a6a151"
  }
}
