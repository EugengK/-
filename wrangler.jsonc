{
  "name": "church-accounting",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Only the Access-protected custom domain should serve this app (add it under "routes" before
  // the first deploy, e.g. { "pattern": "finance.<church domain>", "custom_domain": true }).
  "workers_dev": false,
  "preview_urls": false,
  // The screens (HTML/JS/CSS) contain no data; all data comes from /api, which requires login.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "church-accounting",
      // Replace with the id printed by `wrangler d1 create church-accounting`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Anything other than "development" disables the local-login shortcut.
    "ENVIRONMENT": "production",
    // Cloudflare Access: "<team>.cloudflareaccess.com" and the application's AUD tag.
    // While either is empty, every request is rejected (fails closed).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
